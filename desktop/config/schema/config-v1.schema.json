{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellConfig",
  "type": "object",
  "properties": {
    "bar": {
      "$ref": "#/$defs/BarConfig"
    },
    "capture": {
      "$ref": "#/$defs/CaptureConfig",
      "default": {
        "default_selection": "rectangle",
        "screenshot_dir": "~/Pictures/Screenshots",
        "show_pointer": true
      }
    },
    "clock_format": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "desktop": {
      "$ref": "#/$defs/DesktopConfig",
      "default": {
        "wallpaper_dir": "~/Pictures/Wallpapers",
        "widgets": []
      }
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionsConfig",
      "default": {
        "settings": {}
      }
    },
    "locale": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OutputConfig"
      },
      "default": {}
    },
    "recording": {
      "$ref": "#/$defs/RecordingConfig",
      "default": {
        "delay_seconds": 0,
        "desktop_audio": true,
        "directory": "~/Videos/recordings",
        "framerate": 30,
        "show_pointer": true
      }
    },
    "startup": {
      "$ref": "#/$defs/StartupConfig",
      "default": {
        "autostart_apps": [],
        "compositor_wait_timeout_ms": 3000
      }
    },
    "temperature_unit": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "theme": {
      "$ref": "#/$defs/ThemeConfig"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "theme",
    "bar"
  ],
  "$defs": {
    "BarConfig": {
      "type": "object",
      "properties": {
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "$ref": "#/$defs/BarMargin"
        },
        "opacity": {
          "type": "number",
          "format": "float",
          "default": 0.9200000166893005
        },
        "padding": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/BarPosition"
        },
        "style": {
          "$ref": "#/$defs/BarStyle"
        },
        "widget_spacing": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "$ref": "#/$defs/BarWidgets"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "style",
        "height",
        "padding",
        "margin",
        "widget_spacing",
        "widgets"
      ]
    },
    "BarMargin": {
      "type": "object",
      "properties": {
        "horizontal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vertical": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "horizontal",
        "vertical"
      ]
    },
    "BarPosition": {
      "type": "string",
      "enum": [
        "Top",
        "Bottom",
        "Left",
        "Right"
      ]
    },
    "BarStyle": {
      "type": "string",
      "enum": [
        "Hug",
        "Float",
        "Rect"
      ]
    },
    "BarWidget": {
      "type": "string",
      "pattern": "^(builtin:(workspaces|running_apps|clock|date|media|sysinfo|network|bluetooth|caffeine|audio|battery|settings)|ext:[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,}/[a-z0-9][a-z0-9_-]*)$"
    },
    "BarWidgets": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "end": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "start": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "center",
        "end"
      ]
    },
    "CaptureConfig": {
      "type": "object",
      "properties": {
        "default_selection": {
          "type": "string",
          "default": "rectangle"
        },
        "screenshot_dir": {
          "type": "string",
          "default": "~/Pictures/Screenshots"
        },
        "show_pointer": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "DesktopConfig": {
      "type": "object",
      "properties": {
        "wallpaper_dir": {
          "type": "string",
          "default": "~/Pictures/Wallpapers"
        },
        "widgets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DesktopWidgetConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "DesktopWidgetConfig": {
      "type": "object",
      "properties": {
        "contribution": {
          "$ref": "#/$defs/ExtensionContributionRef"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "instance": {
          "type": "string"
        },
        "output": {
          "type": "string",
          "default": "primary"
        },
        "settings": {
          "default": {}
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "y": {
          "type": "integer",
          "format": "int32",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "contribution",
        "width",
        "height"
      ]
    },
    "ExtensionContributionRef": {
      "type": "string",
      "pattern": "^ext:[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,}/[a-z0-9][a-z0-9_-]*$"
    },
    "ExtensionsConfig": {
      "type": "object",
      "properties": {
        "settings": {
          "description": "Extension-wide settings keyed by extension ID.\n\nEvery contribution instance receives the same validated JSON object.\nSurface-specific placement and geometry remain owned by their surface.",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "OutputConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarMargin"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "padding": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarStyle"
            },
            {
              "type": "null"
            }
          ]
        },
        "widget_spacing": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarWidgets"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RecordingConfig": {
      "type": "object",
      "properties": {
        "delay_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "desktop_audio": {
          "type": "boolean",
          "default": true
        },
        "directory": {
          "type": "string",
          "default": "~/Videos/recordings"
        },
        "framerate": {
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        },
        "show_pointer": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "StartupConfig": {
      "type": "object",
      "properties": {
        "autostart_apps": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "compositor_wait_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 3000,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ThemeConfig": {
      "type": "object",
      "properties": {
        "corner_radius_scale": {
          "type": "number",
          "format": "float"
        },
        "custom_adapter_cmd": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "font_family": {
          "type": "string"
        },
        "gtk_theme_dark": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "gtk_theme_light": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "heading_font_family": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "high_contrast": {
          "type": "boolean",
          "default": false
        },
        "mono_font_family": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "reduced_motion": {
          "type": "boolean",
          "default": false
        },
        "scheme_variant": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "font_family",
        "corner_radius_scale"
      ]
    }
  }
}
