{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellConfig",
  "type": "object",
  "required": [
    "version",
    "theme",
    "bar"
  ],
  "properties": {
    "bar": {
      "$ref": "#/$defs/BarConfig"
    },
    "clock_format": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OutputConfig"
      }
    },
    "startup": {
      "$ref": "#/$defs/StartupConfig",
      "default": {
        "autostart_apps": [],
        "compositor_wait_timeout_ms": 3000
      }
    },
    "temperature_unit": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "theme": {
      "$ref": "#/$defs/ThemeConfig"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BarConfig": {
      "type": "object",
      "required": [
        "position",
        "style",
        "height",
        "padding",
        "margin",
        "widget_spacing",
        "widgets"
      ],
      "properties": {
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "$ref": "#/$defs/BarMargin"
        },
        "padding": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/BarPosition"
        },
        "style": {
          "$ref": "#/$defs/BarStyle"
        },
        "widget_spacing": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "$ref": "#/$defs/BarWidgets"
        }
      },
      "additionalProperties": false
    },
    "BarMargin": {
      "type": "object",
      "required": [
        "horizontal",
        "vertical"
      ],
      "properties": {
        "horizontal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vertical": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BarPosition": {
      "enum": [
        "Top",
        "Bottom",
        "Left",
        "Right"
      ],
      "type": "string"
    },
    "BarStyle": {
      "enum": [
        "Hug",
        "Float",
        "Rect"
      ],
      "type": "string"
    },
    "BarWidget": {
      "enum": [
        "Launcher",
        "Workspaces",
        "ActiveWindow",
        "Clock",
        "Media",
        "Sysinfo",
        "Network",
        "Audio",
        "Battery",
        "Settings"
      ],
      "type": "string"
    },
    "BarWidgets": {
      "type": "object",
      "required": [
        "start",
        "center",
        "end"
      ],
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "end": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "start": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        }
      },
      "additionalProperties": false
    },
    "OutputConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarMargin"
            },
            {
              "type": "null"
            }
          ]
        },
        "padding": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarStyle"
            },
            {
              "type": "null"
            }
          ]
        },
        "widget_spacing": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarWidgets"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ThemeConfig": {
      "type": "object",
      "required": [
        "mode",
        "accent",
        "font_family",
        "corner_radius_scale"
      ],
      "properties": {
        "accent": {
          "type": "string"
        },
        "corner_radius_scale": {
          "type": "number",
          "format": "float"
        },
        "font_family": {
          "type": "string"
        },
        "heading_font_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/ThemeMode"
        },
        "mono_font_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "high_contrast": {
          "default": false,
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "StartupConfig": {
      "type": "object",
      "properties": {
        "autostart_apps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "compositor_wait_timeout_ms": {
          "default": 3000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "ThemeMode": {
      "enum": [
        "Dark",
        "Light",
        "Auto"
      ],
      "type": "string"
    }
  }
}
