{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellConfig",
  "type": "object",
  "required": [
    "version",
    "theme",
    "bar"
  ],
  "properties": {
    "bar": {
      "$ref": "#/$defs/BarConfig"
    },
    "outputs": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OutputConfig"
      }
    },
    "theme": {
      "$ref": "#/$defs/ThemeConfig"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BarConfig": {
      "type": "object",
      "required": [
        "position",
        "style",
        "height",
        "padding",
        "margin",
        "widget_spacing",
        "widgets"
      ],
      "properties": {
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "$ref": "#/$defs/BarMargin"
        },
        "padding": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/BarPosition"
        },
        "style": {
          "$ref": "#/$defs/BarStyle"
        },
        "widget_spacing": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "$ref": "#/$defs/BarWidgets"
        }
      },
      "additionalProperties": false
    },
    "BarMargin": {
      "type": "object",
      "required": [
        "horizontal",
        "vertical"
      ],
      "properties": {
        "horizontal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vertical": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BarPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ]
    },
    "BarStyle": {
      "type": "string",
      "enum": [
        "floating-capsule",
        "full-edge"
      ]
    },
    "BarWidget": {
      "type": "string",
      "enum": [
        "launcher",
        "workspaces",
        "active-window",
        "clock",
        "media",
        "sysinfo",
        "network",
        "audio",
        "battery",
        "settings"
      ]
    },
    "BarWidgets": {
      "type": "object",
      "required": [
        "start",
        "center",
        "end"
      ],
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "end": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        },
        "start": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarWidget"
          }
        }
      },
      "additionalProperties": false
    },
    "OutputConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "exclusive_zone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "margin": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarMargin"
            },
            {
              "type": "null"
            }
          ]
        },
        "padding": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarStyle"
            },
            {
              "type": "null"
            }
          ]
        },
        "widget_spacing": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "widgets": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarWidgets"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ThemeConfig": {
      "type": "object",
      "required": [
        "mode",
        "accent",
        "font_family",
        "corner_radius_scale"
      ],
      "properties": {
        "accent": {
          "type": "string"
        },
        "corner_radius_scale": {
          "type": "number",
          "format": "float"
        },
        "font_family": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ThemeMode"
        }
      },
      "additionalProperties": false
    },
    "ThemeMode": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "auto"
      ]
    }
  }
}
