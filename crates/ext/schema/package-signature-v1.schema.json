{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageSignature",
  "type": "object",
  "properties": {
    "key_rotation": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeyRotationDelegation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "package_hash": {
      "type": "string"
    },
    "public_key": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publisher",
    "public_key",
    "package_hash",
    "signature"
  ],
  "$defs": {
    "KeyRotationDelegation": {
      "type": "object",
      "properties": {
        "authorized_by_registry": {
          "type": "boolean",
          "default": false
        },
        "next_public_key": {
          "type": "string"
        },
        "previous_public_key": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "previous_public_key",
        "next_public_key",
        "signature"
      ]
    }
  }
}
