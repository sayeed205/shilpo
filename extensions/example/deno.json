{
  "minimumDependencyAge": 0,
  "imports": {
    "@shilpo/ext-sdk": "../../sdk/typescript/src/index.ts",
    "@shilpo/ext-sdk/jsx-runtime": "../../sdk/typescript/src/jsx-runtime/index.ts",
    "@shilpo/ext-sdk/jsx-dev-runtime": "../../sdk/typescript/src/jsx-dev-runtime/index.ts",
    "@shilpo/ext-sdk/builder": "../../sdk/typescript/src/builder/index.ts",
    "@shilpo/ext-sdk/manifest": "../../sdk/typescript/src/manifest/index.ts",
    "@shilpo/ext-sdk/testing": "../../sdk/typescript/src/testing/index.ts",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env tests/",
    "check": "deno check src/**/*.ts src/**/*.tsx tests/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2,
    "lineWidth": 100
  }
}
