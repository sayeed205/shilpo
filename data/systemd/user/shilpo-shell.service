[Unit]
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Shilpo Desktop Shell
Documentation=man:shilpo(1) https://github.com/shilpo-rs/shilpo
PartOf=shilpo-session.target
After=shilpo-session.target

[Service]
Type=dbus
BusName=org.shilpo.Shell
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/bin/shilpo daemon
Restart=always
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=5s

[Install]
WantedBy=shilpo-session.target
