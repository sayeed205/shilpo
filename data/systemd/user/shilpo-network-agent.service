[Unit]
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Shilpo NetworkManager Secret Agent
PartOf=shilpo-session.target
After=shilpo-session.target NetworkManager.service

[Service]
ExecStart=/usr/bin/nm-applet --indicator
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=shilpo-session.target
