[Unit]
Description=Shilpo Desktop First-Login Doctor Verification
PartOf=niri.service
After=niri.service shilpo-shell.service shilpo-themed.service shilpo-device-daemon.service
ConditionPathExists=!@FIRST_LOGIN_MARKER@

[Service]
Type=oneshot
ExecStart=/usr/bin/shilpo doctor --first-login
RemainAfterExit=yes

[Install]
WantedBy=niri.service
