[Unit]
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Shilpo Desktop First-Login Doctor Verification
PartOf=shilpo-session.target
After=shilpo-session.target shilpo-shell.service shilpo-themed.service shilpo-device-daemon.service
ConditionPathExists=!@FIRST_LOGIN_MARKER@

[Service]
Type=oneshot
ExecStart=/usr/bin/shilpo doctor --first-login
RemainAfterExit=yes

[Install]
WantedBy=shilpo-session.target
