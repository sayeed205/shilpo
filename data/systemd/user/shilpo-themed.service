[Unit]
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Shilpo Theme Synchronization Engine Daemon
Documentation=man:shilpo(1)
PartOf=shilpo-session.target
After=shilpo-session.target

[Service]
Type=dbus
BusName=org.shilpo.Theme
ExecStart=/usr/bin/shilpo theme-daemon
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=shilpo-session.target
