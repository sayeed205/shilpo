{
  "name": "@shilpo/ext-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./builder": "./src/builder/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.d.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*_test.ts"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts tests/*_test.ts tests/consumers/*.ts tests/fixture/*.ts",
    "generate": "deno run --allow-read --allow-write --allow-run scripts/generate.ts",
    "generate:check": "deno run --allow-read --allow-write --allow-run scripts/generate.ts --check",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env tests/",
    "test:runtimes": "deno run --allow-run --allow-read --allow-env tests/consumers/run.ts",
    "test:component": "deno test --allow-run --allow-read --allow-write --allow-env tests/fixture/component_test.ts",
    "publish:check": "deno publish --dry-run --allow-dirty"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2,
    "lineWidth": 100,
    "exclude": ["src/generated/jco"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/testing": "jsr:@std/testing@1"
  }
}
