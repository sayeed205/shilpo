{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionManifest",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "default": "0.1.0"
    },
    "authors": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "contributions": {
      "$ref": "#/$defs/Contributions",
      "default": {
        "actions": [],
        "background_tasks": [],
        "bar_menus": [],
        "bar_widgets": [],
        "desktop_widgets": [],
        "keyboard_shortcuts": [],
        "search_providers": [],
        "settings_pages": [],
        "side_panels": [],
        "wallpaper_providers": []
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "id": {
      "$ref": "#/$defs/ExtensionId"
    },
    "library": {
      "anyOf": [
        {
          "$ref": "#/$defs/LibraryConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "min_shilpo_version": {
      "type": "string",
      "default": "0.1.0"
    },
    "name": {
      "type": "string"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "default": 2,
      "minimum": 0
    },
    "subscriptions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Subscription"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version"
  ],
  "$defs": {
    "ActionContribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "BackgroundTaskContribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "BarMenuContribution": {
      "type": "object",
      "properties": {
        "bar_widget": {
          "$ref": "#/$defs/ContributionId"
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "bar_widget"
      ]
    },
    "BarWidgetContribution": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "Capability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EventKind"
              }
            },
            "kind": {
              "type": "string",
              "const": "events:subscribe"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "events"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wallpaper:set"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WallpaperSource"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wallpaper:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme:set_source"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notifications:show"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clipboard:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clipboard:write"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "actions:invoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "actions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "network:http"
            },
            "paths": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hosts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem:read"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem:write"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "location:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secrets"
            },
            "purposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SecretPurpose"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "purposes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "search:provide"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ContributionId": {
      "description": "A single-segment identifier naming one contribution within an extension (e.g. `clock`).",
      "type": "string"
    },
    "Contributions": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionContribution"
          }
        },
        "background_tasks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BackgroundTaskContribution"
          }
        },
        "bar_menus": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BarMenuContribution"
          }
        },
        "bar_widgets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BarWidgetContribution"
          }
        },
        "desktop_widgets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DesktopWidgetContribution"
          }
        },
        "keyboard_shortcuts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/KeyboardShortcutContribution"
          }
        },
        "search_providers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SearchProviderContribution"
          }
        },
        "settings_pages": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SettingsPageContribution"
          }
        },
        "side_panels": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SidePanelContribution"
          }
        },
        "wallpaper_providers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WallpaperProviderContribution"
          }
        }
      },
      "additionalProperties": false
    },
    "DesktopWidgetContribution": {
      "type": "object",
      "properties": {
        "default_height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "default_width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "min_height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "min_width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "outputs_changed",
        "theme_changed",
        "palette_generated",
        "wallpaper_changed",
        "network_changed",
        "media_changed",
        "power_changed",
        "timer_fired",
        "workspace_changed"
      ]
    },
    "ExtensionId": {
      "description": "The package identity of an extension (reverse-domain notation, e.g. `io.github.alice`).",
      "type": "string"
    },
    "KeyboardShortcutContribution": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ContributionId"
        },
        "default_binding": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "action"
      ]
    },
    "LibraryConfig": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "SearchProviderContribution": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchProviderMode"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "modes"
      ]
    },
    "SearchProviderMode": {
      "type": "string",
      "enum": [
        "default",
        "apps",
        "actions",
        "clipboard",
        "calculator",
        "command",
        "web_search",
        "keybindings"
      ]
    },
    "SecretPurpose": {
      "type": "string"
    },
    "SettingsPageContribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "schema"
      ]
    },
    "SidePanelContribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "Subscription": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "event"
      ]
    },
    "WallpaperMode": {
      "type": "string",
      "enum": [
        "manual",
        "slideshow"
      ]
    },
    "WallpaperProviderContribution": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WallpaperMode"
          }
        },
        "name": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WallpaperTargetKind"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "modes",
        "targets"
      ]
    },
    "WallpaperSource": {
      "type": "string",
      "enum": [
        "extension_asset",
        "local_file",
        "remote"
      ]
    },
    "WallpaperTargetKind": {
      "type": "string",
      "enum": [
        "global",
        "workspace"
      ]
    }
  }
}
