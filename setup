#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$SCRIPT_DIR
cd "$REPO_ROOT" || exit 1

usage() {
  cat <<'EOF'
Shilpo Build & Install

Usage:
  ./setup install [--prefix DIR]  Build shilpo in release mode and install the binary
  ./setup uninstall [--prefix DIR]  Remove the installed shilpo binary

Options:
  --prefix DIR   Install the binary into DIR/bin instead of the default (~/.local/bin,
                 or /usr/local/bin when run as root)
  -h, --help     Show this help summary
EOF
}

COMMAND=""
PREFIX=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    install|uninstall)
      if [[ -n $COMMAND ]]; then
        echo "error: multiple commands specified: '$COMMAND' and '$1'" >&2
        exit 2
      fi
      COMMAND=$1
      ;;
    --prefix)
      shift
      PREFIX=${1:-}
      if [[ -z $PREFIX ]]; then
        echo "error: --prefix requires a directory argument" >&2
        exit 2
      fi
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument or unsupported option '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -z $COMMAND ]]; then
  usage
  exit 0
fi

if [[ -z $PREFIX ]]; then
  if [[ $(id -u) -eq 0 ]]; then
    PREFIX=/usr/local
  else
    PREFIX="$HOME/.local"
  fi
fi
BIN_DIR="$PREFIX/bin"

case "$COMMAND" in
  install)
    echo "Building shilpo (release)..."
    cargo build --locked --release -p shilpo

    mkdir -p "$BIN_DIR"
    install -Dm755 "$REPO_ROOT/target/release/shilpo" "$BIN_DIR/shilpo"
    echo "Installed shilpo to $BIN_DIR/shilpo"

    case ":$PATH:" in
      *":$BIN_DIR:"*) ;;
      *) echo "note: $BIN_DIR is not on your PATH" ;;
    esac
    ;;
  uninstall)
    rm -f "$BIN_DIR/shilpo"
    echo "Removed $BIN_DIR/shilpo"
    ;;
  *)
    echo "error: unknown command '$COMMAND'" >&2
    usage >&2
    exit 2
    ;;
esac
